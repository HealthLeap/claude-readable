{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/rules/readable-artifacts.md\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' 'Apply the simple-and-visual output style to this response. Its length ceilings are not targets; preserve required detail and requested depth.'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
